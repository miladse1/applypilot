# ApplyPilot settings template. Never put real values in this file.
#
# Real settings live OUTSIDE the repository, in the ApplyPilot data folder:
#   macOS: ~/Library/Application Support/ApplyPilot/.env   (created by ./configure.sh, mode 600)
#   Linux: ~/.local/share/applypilot/.env
# Set APPLYPILOT_HOME to use another data folder. Environment variables override the file.

# --- Data ---------------------------------------------------------------------
# Defaults: <data folder>/applypilot.db and <data folder>/storage. Only set these to override.
# DATABASE_URL=postgresql+psycopg://applypilot:<password>@localhost:5432/applypilot
# STORAGE_DIR=/absolute/path/to/storage

# Demo mode adds labeled practice listings and practice (simulated) submissions.
DEMO_MODE=true
ACCESS_TOKEN_HOURS=12

# Browser origins allowed to call the API directly, and host names the API answers to.
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Single-user: sign-up closes once an account exists. true reopens it.
ALLOW_REGISTRATION=false

# --- AI -------------------------------------------------------------------------
# auto: use Claude when ANTHROPIC_API_KEY is set, else OpenAI, else no AI.
# Without a key, ApplyPilot still parses, ranks, reorders, and highlights, and the
# assistant uses built-in rules. Set the key with ./configure.sh ai (input is hidden).
AI_PROVIDER=auto
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_PREMIUM_MODEL=claude-opus-5-5
AI_EFFORT=medium
OPENAI_MODEL=gpt-4o-mini
# Keys stay empty here. Each empty secret is followed by a comment so scanners do not misread the next line.
ANTHROPIC_API_KEY=""
# OpenAI is optional.
OPENAI_API_KEY=""

# Cost controls (estimated from token usage at list prices).
# Default per-user cap; each user can change theirs in Settings -> AI.
AI_SPEND_LIMIT_USD=4.50
# Hard ceiling for all AI use on this installation per calendar month (all users, background work).
AI_MONTHLY_LIMIT_USD=25.00
# Request rate limits per user (background work counts as one user).
AI_REQUESTS_PER_MINUTE=30
AI_REQUESTS_PER_HOUR=300

# --- Job sources ----------------------------------------------------------------
# Employer career sites, Job Bank, Jobicy, Himalayas, and Remotive. No keys needed.
PUBLIC_JOB_SOURCES=true
# Optional: Adzuna aggregator (free key at https://developer.adzuna.com).
ADZUNA_COUNTRY=ca
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Extra Greenhouse/Lever/Ashby boards, comma-separated, e.g. greenhouse:gitlab,lever:spotify.
JOB_BOARD_TOKENS=

# Re-runs saved searches that have automatic refresh on.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# --- Email (password reset) -----------------------------------------------------
# Set with ./configure.sh email. Without SMTP, development mode writes the reset link
# to the API log; production mode sends nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_FROM=
SMTP_PASSWORD=""

# Set true behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
